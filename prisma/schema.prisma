// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enumeration

enum Role {
  User
  SuperAdmin
  AdminSMK
  AdminJurusan
}

enum Gender {
  Laki_laki
  Perempuan
}

enum KategoriGaleri {
  Pameran
  Lomba
  Pelatihan
  Kunjungan
}

enum StatusProduk {
  Tersedia
  Habis
  Nonaktif
}

enum StatusPublikasi {
  Pending
  Published
  Revisi
}

enum StatusPesan {
  Baru
  Dibaca
  Dibalas
}

enum StatusOrder {
  Menunggu
  Diproses
  Dikirim
  Diterima
  Selesai
  Dibatalkan
}

enum StatusPembayaran {
  Belum_Bayar
  Menunggu_Konfirmasi
  Lunas
  Gagal
}

enum JenisTransaksi {
  Pemasukan
  Pengeluaran
}

enum StatusSettlementTransaksi {
  Selesai
  Menunggu
  Gagal
  Dibatalkan
  Dikembalikan
}

enum StatusPenarikan {
  Pending
  Diproses
  Selesai
  Ditolak
}

enum MetodePembayaran {
  Transfer
  Tunai
  COD
  QRIS
  E_Wallet
}

enum StatusRefund {
  Diajukan
  Diproses
  Disetujui
  Ditolak
}

enum TipeBuktiRefund {
  Foto
  Video
}

// Model Database

model User {
  user_id  String @id @default(uuid())
  name     String
  email    String @unique
  password String
  phone    String?
  img      String?
  role     Role   @default(User)
  gender   Gender? 
  isActive Boolean @default(true)

  smk      SMK?
  jurusan  Jurusan?
  alamat Alamat[]
  review   Review[]
  galeri   Galeri[]
  favorites Favorite[] 

  resetToken       String?
  resetTokenExpiry DateTime?

  order     Order[]
  transaksi Transaksi[]
  penarikanSaldo PenarikanSaldo[]
  refundRequest RefundRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SMK {
  smk_id String @id @default(uuid())

  user_id String @unique
  user    User   @relation(fields: [user_id], references: [user_id])

  kepala_sekolah    String?
  deskripsi         String?
  alamat            String
  kecamatan         String?
  kota              String
  kota_id           Int?  
  kode_pos          String?
  provinsi          String
  tahun_berdiri     Int
  status_verifikasi Boolean @default(false)

  jurusans Jurusan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Jurusan {
  jurusan_id String @id @default(uuid())

  user_id String @unique
  user    User   @relation(fields: [user_id], references: [user_id])

  smk_id String
  smk    SMK    @relation(fields: [smk_id], references: [smk_id])

  nama_jurusan    String
  deskripsi       String?
  kepala_jurusan  String?
  jam_operasional String?

  produk Produk[]
  kurirAktif KurirAktif[]
  transaksi Transaksi[]
  penarikan PenarikanSaldo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Alamat {
  alamat_id String @id @default(uuid())

  user_id String
  user    User   @relation(fields: [user_id], references: [user_id])

  nama_penerima  String
  nomor_telepon  String
  alamat_lengkap String
  kecamatan      String
  kota           String
  provinsi       String
  kode_pos       String
  kota_id        Int?
  isUtama        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Produk {
  produk_id String @id @default(uuid())

  jurusan_id String
  jurusan    Jurusan @relation(fields: [jurusan_id], references: [jurusan_id])

  nama_produk String
  deskripsi   String?
  harga       Int
  status      StatusProduk @default(Tersedia)
  view_count  Int          @default(0)
  sold_count  Int          @default(0)

  status_publikasi StatusPublikasi @default(Pending)
  catatan_revisi   String?  

  foto   FotoProduk[]
  barang Barang[]
  jasa   Jasa[]
  review Review[]
  favorites Favorite[]
  orderDetail Order_Detail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FotoProduk {
  foto_id String @id @default(uuid())

  produk_id String
  produk    Produk @relation(fields: [produk_id], references: [produk_id])

  url String

  createdAt DateTime @default(now())
}

model Barang {
  barang_id String @id @default(uuid())

  produk_id String
  produk    Produk @relation(fields: [produk_id], references: [produk_id])

  stok    Int    @default(0)
  kondisi String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Jasa {
  jasa_id String @id @default(uuid())

  produk_id String
  produk    Produk @relation(fields: [produk_id], references: [produk_id])

  nama_jasa           String
  estimasi_pengerjaan String?
  total_project       Int     @default(0)

  portofolio Portofolio[]
  favorites Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Portofolio {
  portofolio_id String @id @default(uuid())

  jasa_id String
  jasa    Jasa   @relation(fields: [jasa_id], references: [jasa_id])

  file_path String
  deskripsi String?

  createdAt DateTime @default(now())
}

model Review {
  review_id String @id @default(uuid())

  user_id String
  user    User   @relation(fields: [user_id], references: [user_id])

  produk_id String
  produk    Produk @relation(fields: [produk_id], references: [produk_id])

  order_detail_id String       @unique
  orderDetail     Order_Detail @relation(fields: [order_detail_id], references: [order_detail_id])


  rating   Int
  komentar String?

  foto FotoReview[]

  createdAt DateTime @default(now())
}

model FotoReview {
  foto_id String @id @default(uuid())

  review_id String
  review    Review @relation(fields: [review_id], references: [review_id], onDelete: Cascade)

  url String

  createdAt DateTime @default(now())
}

model Galeri {
  galeri_id String @id @default(uuid())

  user_id String
  user    User   @relation(fields: [user_id], references: [user_id])

  judul     String
  deskripsi String?
  kategori  KategoriGaleri
  image     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TentangTefa {
  tentang_id String @id @default(uuid())

  deskripsi String  @db.Text
  videoLink String?

  dokumentasi TentangTefaFoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TentangTefaFoto {
  foto_id String @id @default(uuid())

  tentang_id String
  tentang    TentangTefa @relation(fields: [tentang_id], references: [tentang_id])

  url String

  createdAt DateTime @default(now())
}

model Pesan {
  pesan_id String @id @default(uuid())

  nama  String
  email String
  phone   String   @default("Tidak ada nomor")
  pesan String

  status StatusPesan @default(Baru)
  
  isRead     Boolean @default(false)
  isFavorite Boolean @default(false)
  isDeleted  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  order_id String @id @default(uuid())

  user_id String
  user    User   @relation(fields: [user_id], references: [user_id])
  
  kode_invoice String?

  total_harga       Int
  status_order      StatusOrder      @default(Menunggu)
  status_pembayaran StatusPembayaran @default(Belum_Bayar)

  orderDetail Order_Detail[]
  transaksi   Transaksi[]
  pengiriman  Pengiriman?
  refundRequest RefundRequest?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order_Detail {
  order_detail_id String @id @default(uuid())

  order_id String
  order    Order  @relation(fields: [order_id], references: [order_id])

  produk_id String
  produk    Produk @relation(fields: [produk_id], references: [produk_id])

  jumlah       Int
  harga_satuan Int
  subtotal     Int

  review Review?

  createdAt DateTime @default(now())

  @@unique([order_id, produk_id])
}

model Transaksi {
  transaksi_id String @id @default(uuid())

  order_id String?
  order    Order?  @relation(fields: [order_id], references: [order_id])

  user_id String
  user    User   @relation(fields: [user_id], references: [user_id])

  jurusan_id String?
  jurusan    Jurusan? @relation(fields: [jurusan_id], references: [jurusan_id])

  tanggal_transaksi DateTime         @default(now())
  jenis_transaksi   JenisTransaksi
  kategori          String?
  nama              String?
  deskripsi         String?          @db.Text
  nominal           Int
  bukti             String?            
  metode            MetodePembayaran?
  kode_pembayaran   String?
  biaya_midtrans Int? @default(0)
  status_settlement StatusSettlementTransaksi @default(Selesai)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PenarikanSaldo {
  penarikan_id String @id @default(uuid())

  jurusan_id String
  jurusan    Jurusan @relation(fields: [jurusan_id], references: [jurusan_id])

  user_id String
  user    User   @relation(fields: [user_id], references: [user_id])

  nominal        Int
  nama_bank      String
  nomor_rekening String
  atas_nama      String

  status         StatusPenarikan @default(Pending)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pengiriman {
  pengiriman_id String @id @default(uuid())

  order_id String @unique
  order    Order  @relation(fields: [order_id], references: [order_id])

  nama_penerima String
  alamat        String
  kurir         String
  ongkir        Int
  nomor_resi String?
  estimasi_tiba String?
  status_resi      String?
  cek_terakhir_at  DateTime?
  diterima_at      DateTime?
  auto_confirmed   Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  produkId  String?
  jasaId    String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [user_id], onDelete: Cascade)
  produk Produk? @relation(fields: [produkId], references: [produk_id], onDelete: Cascade)
  jasa   Jasa?   @relation(fields: [jasaId], references: [jasa_id], onDelete: Cascade)

  @@unique([userId, produkId])
  @@unique([userId, jasaId])
}

model KurirAktif {
  kurir_aktif_id String @id @default(uuid())

  jurusan_id String
  jurusan    Jurusan @relation(fields: [jurusan_id], references: [jurusan_id], onDelete: Cascade)

  kode_kurir String
  nama_kurir String
  status     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jurusan_id, kode_kurir])
}

model RefundRequest {
  refund_id String @id @default(uuid())

  order_id String @unique
  order    Order  @relation(fields: [order_id], references: [order_id])

  user_id String
  user    User   @relation(fields: [user_id], references: [user_id])

  alasan       String
  deskripsi    String @db.Text
  status       StatusRefund @default(Diajukan)
  catatanAdmin String?

  bukti RefundBukti[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefundBukti {
  bukti_id String @id @default(uuid())

  refund_id String
  refund    RefundRequest @relation(fields: [refund_id], references: [refund_id], onDelete: Cascade)

  url  String
  tipe TipeBuktiRefund

  createdAt DateTime @default(now())
}